# VARIABLES {{{
  set $mod Mod4
  set $alt Mod1
  set $gui Mod4
  set $y #787a00
  set $g #757575
  set $d #ffffff
  set $w #000000
  set $ws1 "1:1"
  set $ws2 "2:2"
  set $ws3 "3:3"
  set $ws4 "4:4"
  set $ws5 "5:5"
  set $ws6 "6:6"
  set $ws7 "7:7"
  set $ws8 "8:8"
  set $ws9 "9:9"
  set $ws10 "10:10"
  set $window ""
  set $scrot_path "/home/paczur/Multimedia/Pictures/Screenshots/Scrot/%d-%m-%Y_%H-%M-%S_$wx$h.png"
#}}}

# WORKSPACES {{{
    workspace $ws1 output $m1
    workspace $ws2 output $m1
    workspace $ws3 output $m1
    workspace $ws4 output $m1
    workspace $ws5 output $m1
    workspace $ws6 output $m1
    workspace $ws7 output $m2
    workspace $ws8 output $m2
    workspace $ws9 output $m2
    workspace $ws10 output $m1

    assign [class="^TelegramDesktop$"] $ws7
    assign [class="^firefox$"] $ws1
    assign [class="^KeePassXC$"] $ws6
#}}}

# KEYBINDS {{{
  bindsym $mod+Ctrl+Left workspace prev
  bindsym $mod+Ctrl+Right workspace next
  bindsym $mod+Shift+Ctrl+Left move container to workspace prev
  bindsym $mod+Shift+Ctrl+Right move container to workspace next
  bindsym $alt+F4 kill
  bindsym $mod+f fullscreen toggle
  bindsym $mod+g floating toggle
  bindsym $mod+b split h
  bindsym $mod+v split v
  bindsym $alt+Tab focus right
  bindsym Shift+$alt+Tab focus left
  bindsym $mod+h focus left
  bindsym $mod+j focus down
  bindsym $mod+k focus up
  bindsym $mod+l focus right
  bindsym $mod+Shift+h move left
  bindsym $mod+Shift+j move down
  bindsym $mod+Shift+k move up
  bindsym $mod+Shift+l move right
  bindsym --release Print exec scrot -s -q 100 -e "xclip -selection clipboard -t image/png -i $scrot_path" $scrot_path
  bindsym Ctrl+Escape exec dmenu_run -f -i -fn "CodeNewRoman Nerd Font Propo:size=14" -nb "$d" -nf "$w" -sb "$g" -sf "$w" -w "$(xwininfo -name "i3bar for output $m1" | grep -o '0x[0123456789abcdef]\+' | head -n1)"
  bindsym $mod+Return exec "xterm -e tmux"

  bindsym XF86MonBrightnessDown exec sudo backlight - && pkill -SIGRTMIN+11 i3blocks
  bindsym XF86MonBrightnessUp exec sudo backlight + && pkill -SIGRTMIN+11 i3blocks
  bindsym XF86AudioMute exec volume m && pkill -SIGRTMIN+13 i3blocks
  bindsym XF86AudioLowerVolume exec volume - && pkill -SIGRTMIN+13 i3blocks
  bindsym XF86AudioRaiseVolume exec volume + && pkill -SIGRTMIN+13 i3blocks
  bindsym XF86WLAN exec wpa_cli scan && sleep 2 && pkill -SIGRTMIN+12 i3blocks
#}}}

# BAR {{{
  bar {
    output $m1
    output $m2
    tray_output none
    position top
    separator_symbol " "
    status_command i3blocks
    workspace_buttons yes
    strip_workspace_numbers yes
    padding 3 0
    workspace_min_width 40
    i3bar_command i3bar
# COLORS {{{
  colors {
    #class             border background text
    active_workspace   $g     $g         $w
    focused_workspace  $w     $w         $d
    inactive_workspace $g     $g         $w
    urgent_workspace   $y     $y         $d
    binding_mode       $w     $d         $w
    background $d
    statusline $d
  }
}
#}}}
#}}}

# COLORS {{{
#class                  title_border bg text indicator border
  client.focused          $w           $d $w   $w        $w
  client.focused_inactive $g           $d $w   $g        $g
  client.unfocused        $g           $d $w   $g        $g
  client.urgent           $y           $d $d   $y        $y
  client.background $g
#}}}

# USABILITY {{{
  font pango: CodeNewRoman Nerd Font Propo, IPAexGothic 14

  default_floating_border pixel 8
  default_border pixel 4
  for_window [floating_from="user"] border pixel 8
  for_window [tiling_from="user"] border pixel 4
  popup_during_fullscreen leave_fullscreen
  focus_on_window_activation none
  no_focus [tiling]
  mouse_warping none
  focus_follows_mouse no
  floating_modifier $mod
#}}}
